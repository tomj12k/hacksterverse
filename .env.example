# Hackster Studio optional image generation settings.
#
# Copy this file to .env, then add real secrets locally. The build pipeline does
# not call any image backend unless --generate-images is explicitly enabled.

# Choose: openai or comfyui.
HACKSTER_IMAGE_BACKEND=comfyui

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Local DGX text planner backend. This should be an OpenAI-compatible LLM
# endpoint such as vLLM, Ollama, or LM Studio. ComfyUI below is only for images.
DGX_LLM_BASE_URL=http://192.168.68.136:8000/v1
DGX_LLM_MODEL=Qwen3-32B-AWQ
DGX_LLM_API_KEY=

# Optional DGX service handoff. When enabled, Hackster Studio starts vLLM for
# DGX planning, then stops it before ComfyUI image generation so FLUX has VRAM.
HACKSTER_DGX_MANAGE_SERVICES=0
HACKSTER_DGX_SSH_HOST=sync-spark-d1a9_local
HACKSTER_DGX_VLLM_SERVICE=vllm-planner.service
HACKSTER_DGX_VLLM_LOG=/home/pizzacat/ai/logs/vllm-planner.log
HACKSTER_DGX_MODEL_CONFIG=configs/dgx_model_profiles.yaml
HACKSTER_DGX_PLANNER_PROFILE=qwen3_32b_awq
HACKSTER_DGX_IMAGE_PROFILE=flux_dev
HACKSTER_DGX_PLANNER_READY_TIMEOUT_SECONDS=600
HACKSTER_DGX_FORCE_KILL_ON_STOP_TIMEOUT=1

# Local DGX/ComfyUI backend.
COMFYUI_URL=http://192.168.68.136:8188

# Optional if you put ComfyUI behind a trusted LAN auth proxy.
COMFYUI_USERNAME=
COMFYUI_PASSWORD=

# Optional local API-format workflow JSON. If unset, Hackster Studio uses a
# built-in FLUX workflow by default. Set COMFYUI_WORKFLOW_KIND=sdxl for the
# older checkpoint workflow.
COMFYUI_WORKFLOW_PATH=
COMFYUI_WORKFLOW_KIND=flux

# FLUX defaults for the DGX ComfyUI setup.
COMFYUI_UNET=flux1-dev.safetensors
COMFYUI_UNET_DTYPE=fp8_e4m3fn
COMFYUI_CLIP_1=t5xxl_fp16.safetensors
COMFYUI_CLIP_2=clip_l.safetensors
COMFYUI_CLIP_TYPE=flux
COMFYUI_VAE=ae.safetensors
COMFYUI_FLUX_GUIDANCE=4.0

# SDXL/checkpoint fallback.
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_NEGATIVE_PROMPT=text, letters, captions, title, typography, watermark, logo, numerals, numbers, glyphs, symbols, code marks, text-like markings, mouth, smile, frown, open mouth, mouth slit, teeth, nose, lower face features, face marks below eyes, hoodie symbol, shirt symbol, pseudo logo, shoe text, wrist text, labels, patches, decals, insignia, internal gem marks, grid, gridlines, halftone, moire, scary imagery, realistic weapons, harsh shadows
COMFYUI_GENERATION_WIDTH=1344
COMFYUI_GENERATION_HEIGHT=1344
COMFYUI_WIDTH=2688
COMFYUI_HEIGHT=2688
COMFYUI_STEPS=28
COMFYUI_TIMEOUT_SECONDS=3600
COMFYUI_DPI=300
COMFYUI_CFG=1.0
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=simple
COMFYUI_VAE_TILE_SIZE=768
COMFYUI_VAE_TILE_OVERLAP=96
COMFYUI_OUTPUT_PREFIX=hackster_niko

# Character LoRA training. The character bench "Process Selected Set Now" button
# launches this command once at least HACKSTER_LORA_MIN_IMAGES (default 20)
# examples are selected. The bundled launcher dry-runs (logs a plan, no real
# training) until you set HACKSTER_DGX_LORA_TRAINER_CMD to your DGX trainer.
HACKSTER_DGX_LORA_TRAIN_COMMAND=bash scripts/train_lora_dgx.sh
HACKSTER_DGX_LORA_TRAINER_CMD=
HACKSTER_LORA_MIN_IMAGES=20

# OPTIONAL ComfyUI-native FLUX LoRA trainer (hackster_studio.automation.lora_training).
# WARNING: on the current DGX (GB10, 124GB unified) a real TrainLoraNode run
# OOM-crashes the ComfyUI server (graph submits fine; the training step kills it),
# even with offloading. Leave this UNSET until the DGX training memory issue is
# resolved; enabling it will take ComfyUI down mid-run.
# HACKSTER_DGX_LORA_TRAINER_CMD=.venv/bin/python -m hackster_studio.automation.lora_training
# HACKSTER_LORA_STEPS=1000
# HACKSTER_LORA_RANK=16
# HACKSTER_LORA_OFFLOADING=1
